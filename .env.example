# Shared
NODE_ENV=development
KEDOV_LOG_LEVEL=info

# NestJS API (services/api)
API_PORT=4000
# In-memory stores when unset / non-postgres. Postgres enables RLS tenant GUCs.
API_DATABASE_URL=file:./dev.sqlite
# Migrate as kedov, then run API as kedov_app (see 004_app_role.sql):
# API_DATABASE_URL=postgresql://kedov_app:kedov_app_dev_only@localhost:5432/kedov
API_CORS_ORIGIN=http://localhost:3001
# Auth: demo (local headers) | oidc (Bearer JWT)
AUTH_MODE=demo
# Silent env identity fallback — disabled in production unless explicitly true
# AUTH_ALLOW_DEMO_ENV_FALLBACK=false
# Optional demo tenant for local shell (ignored when AUTH_MODE=oidc)
API_DEMO_ORG_ID=org_demo
API_DEMO_USER_ID=user_demo
# OIDC production: JWKS (RS256). Clerk: issuer https://<instance>.clerk.accounts.dev
# OIDC_ISSUER=https://issuer.example
# OIDC_JWKS_URL=https://issuer.example/.well-known/jwks.json
# OIDC_AUDIENCE=kedov-api
# Optional top-level org claim override (default: org_id | orgId | o.id)
# OIDC_ORG_CLAIM=
# Local/dev HS256 only when JWKS is not configured
# API_OIDC_HS256_SECRET=

# Studio web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_AI_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_USE_DEMO_FIXTURES=true
# demo | oidc — oidc needs token via setAccessTokenGetter or NEXT_PUBLIC_DEMO_OIDC_TOKEN
NEXT_PUBLIC_AUTH_MODE=demo
NEXT_PUBLIC_DEMO_USER_ID=user_demo
NEXT_PUBLIC_DEMO_ORG_ID=org_demo
# NEXT_PUBLIC_DEMO_OIDC_TOKEN=

# Marketing
NEXT_PUBLIC_STUDIO_URL=http://localhost:3001
NEXT_PUBLIC_DOWNLOADS_URL=/downloads

# FastAPI AI gateway
AI_API_HOST=0.0.0.0
AI_API_PORT=8000
AI_PROVIDER=mock
# Nest optional proxy to AI gateway for prompt plans
# AI_API_BASE_URL=http://localhost:8000
# Only set when explicitly authorizing cloud inference (also requires cloud_consent)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
