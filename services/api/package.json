    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.12",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/pg": "8.23.1",
    "@types/supertest": "^6.0.2",
